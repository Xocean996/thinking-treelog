{
    "name":  "@thinking-treelog/dsh-plugin",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Turn any pasted conversation into a navigable, branchable thought tree inside dsh.",
    "license":  "MIT",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           }
            },
    "publishConfig":  {
                          "access":  "public"
                      }
}
