                    "test:rhythm":  "node scripts/rhythm.test.mjs",
                    "test:weekly":  "node scripts/weekly.test.mjs",
                    "test:workspace":  "node scripts/workspace.test.mjs",
                    "test:trace":  "node scripts/trace.test.mjs",
